# Where the enquiry form POSTs its JSON.
# Defaults to /api/contact: the Vercel function in api/contact.ts on bramwell.top,
# and the Sites Worker in sites/worker.js on the Freebuff preview.
# Set this only to point the form at a different service (Formspree, Basin).
VITE_CONTACT_ENDPOINT=

# --- Delivery (server side only, never in the bundle) -----------------------
# Set these in Vercel -> Settings -> Environment Variables for bramwell.top,
# and in Sites -> Secrets for the preview.
# RESEND_API_KEY   secret   Resend API key. Without it the form reports that it
#                           is not connected instead of pretending to send.
# CONTACT_TO       var      Inbox that receives enquiries. Default: hello@bramwell.com
# CONTACT_FROM     var      Verified sender. Default: Bramwell Enquiries <onboarding@resend.dev>
